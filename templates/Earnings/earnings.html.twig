{% extends "base.html.twig" %}


{% block title %}{{ parent() }} &ndash; Earnings{% endblock %}


{% block body %}
    <div class="container py-3">
        <h1>Earnings</h1>
        <div id="stockTable">
            <table class="stocks table table-striped">
                <colgroup>
                    <col style="width:50%;">
                    <col style="width:25%;">
                    <col style="width:25%;">
                </colgroup>
                <thead>
                <tr>
                    <th>Wertpapier</th>
                    <th>Nächster Termin</th>
                    <th>Countdown</th>
                </tr>
                </thead>
                <tbody>
                    {% for stock in stocks %}
                        <tr>
                            <th>
                                <a href="https://finance.yahoo.com/quote/{{ stock.currentPriceSymbol }}/" rel="external" class="stock-name">{{ stock.name }}</a>
                                {% if stock.daysUntilEarnings > -1 and stock.daysUntilEarnings < 3 %}<span class="help" title="Earnings {{ stock.nextEarningsTime|sonata_format_datetime }}">💰</span>{% endif %}
                            </th>
                            <td>{{ stock.nextEarningsTime|sonata_format_datetime }}</td>
                            <td>{% if stock.daysUntilEarnings > 0 %}{{ stock.daysUntilEarnings }} Tage{% else %}{{ stock.hoursUntilEarnings }} Std.{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% for stock in stocks %}
    <tr{% if not stock.quantity %} class="watchlist"{% endif %}>
        <th style="background-image: url('{{ path("stock_change_history", {"id": stock.id}) }}?t={{ "now"|date("YmdH") }}');">
            <div>
                <a href="https://finance.yahoo.com/quote/{{ stock.currentPriceSymbol }}/" rel="external" class="stock-name">{{ stock.name }}</a>
                <span class="actions">
                    <a href="{{ path("stock_edit", {"id": stock.id}) }}" class="btn btn-primary px-1 py-0"><span class="bi bi-pencil-fill" title="Bearbeiten"></span></a>
                    <button class="btn btn-danger px-1 py-0" data-delete-stock="{{ stock.id }}" data-delete-stock-name="{{ stock.name }}" title="Löschen"><span class="bi bi-x-circle-fill"></span></button>
                    <a href="{{ path("stock_favourite", {"id": stock.id}) }}" class="btn btn-warning px-1 py-0"><span class="bi {% if stock.favourite %}bi-star{% else %}bi-star-fill{% endif %}"></span></a>
                </span>
            </div>
        </th>

        <td class="d-none d-sm-table-cell isPrivate">{% if stock.quantity %}{{ stock.quantity|sonata_number_format_decimal }}{% else %}&ndash;{% endif %}</td>

        <td class="d-none d-sm-table-cell">
            {% if stock.initialPrice is not null %}
                <div class="secondaryValue">{{ stock.initialPrice|sonata_number_format_currency(stock.currency) }}</div>
                {% if stock.investment %}<div class="isPrivate">{{ stock.investment|sonata_number_format_currency(stock.currency) }}</div>{% endif %}
            {% else %}
                &ndash;
            {% endif %}
        </td>

        <td class="d-none d-sm-table-cell">
            {% if stock.currentPrice is not null %}
                <div class="secondaryValue">{{ stock.currentPrice|sonata_number_format_currency(stock.currency) }}</div>
                {% if stock.currentValue %}<div class="isPrivate">{{ stock.currentValue|sonata_number_format_currency(stock.currency) }}</div>{% endif %}
            {% else %}
                &ndash;
            {% endif %}
        </td>

        {% if stock.profit is not null %}
            <td class="{{ stock.profitIndicator }}">
                <div>{{ stock.profitPercent|sonata_number_format_percent({'fraction_digits': 2}, {'positive_prefix': '+'}) }}</div>
                <div class="isPrivate">{{ stock.profit|sonata_number_format_currency(stock.currency, {}, {'positive_prefix': '+'}) }}</div>
            </td>
        {% else %}
            <td>&ndash;</td>
        {% endif %}

        {% if stock.changeSinceLastDayPercent is not null %}
            <td class="help {{ stock.changeSinceLastDayIndicator }}" title="{{ stock.currentChangePercent|sonata_number_format_percent({'fraction_digits': 2}, {'positive_prefix': '+'}) }}{{ "\n" }}{{ stock.currentPriceExchange.label }} {{ stock.currentPriceExchange.flag }} ({{ stock.currentPriceMarket|title }} Market){{ "\n" }}{{ stock.currentPriceTime|sonata_format_datetime }}">
                <div>
                    <span class="indicator"></span>{{ stock.changeSinceLastDayPercent|sonata_number_format_percent({'fraction_digits': 2}, {'positive_prefix': '+'}) }}
                </div>
                <div class="isPrivate">{{ stock.changeSinceLastDay|sonata_number_format_currency(stock.currency, {}, {'positive_prefix': '+'}) }}</div>
            </td>
        {% else %}
            <td>&ndash;</td>
        {% endif %}
    </tr>
{% endfor %}

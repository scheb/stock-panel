<table class="stocks table table-striped">
    <colgroup>
        <col style="width:50%;">
        <col style="width:10%;" class="hideColumn isPrivate">
        <col style="width:10%;" class="hideColumn">
        <col style="width:10%;" class="hideColumn">
        <col style="width:10%;">
        <col style="width:10%;">
    </colgroup>
    <thead>
    <tr>
        <th>Aktie</th>
        <th class="d-none d-sm-table-cell isPrivate">Anzahl</th>
        <th class="d-none d-sm-table-cell">Einstand</th>
        <th class="d-none d-sm-table-cell">Aktuell</th>
        <th>Profit</th>
        <th>Heute</th>
    </tr>
    </thead>
    {% for categoryName, stocks in categories %}
        <tbody>
        <tr class="table-active">
            <th colspan="6">{{ categoryName }}</th>
        </tr>
        {% include "Panel/tableCategory.html.twig" %}
        </tbody>
    {% endfor %}
</table>

<p class="small text-muted text-end mb-1">{{ lastUpdateDate|sonata_format_datetime("E d.M.Y H:m:s") }}</p>
<table class="stocks table table-striped">
    <colgroup>
        <col style="width:50%;">
        <col style="width:10%;" class="hideColumn isPrivate">
        <col style="width:10%;" class="hideColumn">
        <col style="width:10%;" class="hideColumn">
        <col style="width:10%;">
        <col style="width:10%;">
    </colgroup>
    <thead>
    <tr>
        <th>Wertpapier</th>
        <th class="d-none d-sm-table-cell isPrivate">Anzahl</th>
        <th class="d-none d-sm-table-cell">Einstand</th>
        <th class="d-none d-sm-table-cell">Aktuell</th>
        <th>Profit</th>
        <th>Heute</th>
    </tr>
    </thead>
    {% for categoryName, stocks in categories %}
        <tbody>
        <tr class="table-active">
            <th colspan="6">{{ categoryName }}</th>
        </tr>
        {% include "Panel/tableRows.html.twig" %}
        </tbody>
    {% endfor %}
    <tfoot class="isPrivate">
        <tr>
            <td></td>
            <td class="hideColumn"></td>
            <td class="hideColumn"></td>
            <td class="hideColumn d-none d-sm-table-cell">{{ performance.currentValue|sonata_number_format_currency(performance.currency) }}</td>
            <td class="{{ performance.profitIndicator }}">
                <div>{{ performance.profitPercent|sonata_number_format_percent({'fraction_digits': 2}, {'positive_prefix': '+'}) }}</div>
                <div class="isPrivate">{{ performance.profit|sonata_number_format_currency(performance.currency, {}, {'positive_prefix': '+'}) }}</div>
            </td>
            <td></td>
        </tr>
    </tfoot>
</table>
